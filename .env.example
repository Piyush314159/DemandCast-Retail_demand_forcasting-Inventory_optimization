# MySQL connection used by the Python pipeline. Keep real credentials in .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=demandcast
MYSQL_USER=demandcast
MYSQL_PASSWORD=

# Optional complete URL. Overrides host/user fields, never falls back to SQLite.
# URL-encode reserved characters when writing a complete URL manually.
DEMANDCAST_DATABASE_URL=

# Project-local helper only. Generated by: python scripts/mysql_local.py init
MYSQL_ROOT_PASSWORD=

# Optional test admin URL; tests create fresh demandcast_test_* schemas only.
# Without this setting, MySQL integration tests are explicitly skipped.
DEMANDCAST_TEST_MYSQL_URL=

# ─────────────────────────────────────────────────────────────
#  DemandCast — Environment Variables Template
#  ✅  This file IS committed to git (no real secrets here)
#  📋  Copy this to .env.local and fill in your real values
# ─────────────────────────────────────────────────────────────
#
#  Setup steps:
#    1. cp .env.example .env.local
#    2. Open .env.local and replace the placeholder with your key
#    3. Restart the dev server: npm run dev
#
# ─────────────────────────────────────────────────────────────

# AI API Keys (OpenAI or Google Gemini supported)
# OpenAI: https://platform.openai.com/api-keys (starts with sk-)
NEXT_PUBLIC_OPENAI_API_KEY=
# Google Gemini: https://aistudio.google.com/app/apikey (starts with AIza)
NEXT_PUBLIC_GEMINI_API_KEY=

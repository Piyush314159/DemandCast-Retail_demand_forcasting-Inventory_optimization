# Data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Models
models/*
!models/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# Reports
reports/figures/*
!reports/figures/.gitkeep

# OS / editor
.DS_Store
.vscode/

# Environment files & Secrets
.env*
!.env.example

# Regenerable dashboard snapshot; never bundle the raw sales database.
dashboard/data/*.json
dashboard/data/*.tmp
